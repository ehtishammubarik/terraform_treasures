# State. Contains every secret the plan touched, in plaintext.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl.bak

# Real variable values. Only .example files are tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Plans can contain secrets.
*.tfplan
plan.out
crash.log
crash.*.log

# Credentials
.env
*.pem
*.key
*.p12
.aws/

# Editor and OS
.vscode/
.idea/
.DS_Store
