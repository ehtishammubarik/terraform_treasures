aws_region = "us-east-1"

# Never 0.0.0.0/0. Both are validated and will fail at plan time.
db_allowed_cidrs      = ["10.0.0.0/16"]
bastion_allowed_cidrs = ["203.0.113.0/24"]   # your office or VPN range

db_username   = "app"
db_identifier = "app-db"

# db_password is deliberately absent. Supply it at apply time:
#   export TF_VAR_db_password=$(aws secretsmanager get-secret-value \
#     --secret-id app/db --query SecretString --output text)
